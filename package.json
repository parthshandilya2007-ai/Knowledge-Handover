{
  "name": "knowledge-handover-root",
  "version": "1.0.0",
  "private": true,
  "description": "Knowledge Handover Platform: Replace the Person, Not the Knowledge",
  "scripts": {
    "start:backend": "npm --prefix backend run dev",
    "start:ai": "cd ai-service && .venv\\Scripts\\python -m uvicorn app.main:app --host 0.0.0.0 --port 8000 --reload",
    "start:frontend": "npm --prefix frontend run dev",
